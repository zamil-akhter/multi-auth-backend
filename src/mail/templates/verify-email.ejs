<!-- src/mail/templates/verify-email.ejs -->
<!DOCTYPE html>
<html>
  <body style="font-family: Arial, sans-serif; padding: 24px">
    <h2>Hi <%= name %>,</h2>
    <p>Thanks for signing up. Please verify your email address by clicking below:</p>
    <a href="<%= verifyUrl %>" style="display: inline-block; padding: 10px 20px; background: #4f46e5; color: #fff; text-decoration: none; border-radius: 6px"> Verify Email </a>
    <p>This link expires in 1 hour. If you didn't sign up, ignore this email.</p>
  </body>
</html>
